# Inbound webhook that the "Apply to partner with us" form posts to.
# In GoHighLevel: Automation > Workflows > new workflow > "Inbound Webhook" trigger,
# then copy the webhook URL it gives you and paste it here.
# Copy this file to .env and fill it in. Restart the dev server after changing it.
VITE_GHL_WEBHOOK_URL=

# Fractional CMO landing page (/fractional-cmo). All optional.
# Calendar embed for the booking section (GoHighLevel calendar, Calendly, etc). Leave empty to show the built-in form,
# which posts to VITE_GHL_WEBHOOK_URL above with form: "growth-audit".
VITE_BOOKING_URL=
# Meta Pixel id and GA4 measurement id. Each tag loads on that page only when its id is set.
VITE_META_PIXEL_ID=
VITE_GA4_ID=

# OpenAI, used by the AI Search Readiness Checker below. Server only: no VITE_ prefix, so the key never reaches the browser.
# Set a monthly spend limit in the OpenAI dashboard.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=

# AI Search Readiness Checker (/ai-search-readiness). All server only. See README, "AI Search Readiness Checker".
FIRECRAWL_API_KEY=
PAGESPEED_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Leads from the checker post here from the server. Falls back to VITE_GHL_WEBHOOK_URL above.
GHL_WEBHOOK_URL=
